# Firebase (Firestore) — copy to .env.local and fill in from your Firebase
# project settings (Project settings → General → Your apps → Web app).
# Leave these unset and the app runs fully on localStorage instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (unsigned uploads) — sign up free at cloudinary.com, then
# Settings → Upload → Upload presets → add a preset with Signing Mode set
# to "Unsigned". Leave these unset and photo inputs fall back to storing a
# resized image locally instead (no upload, no external service).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google Calendar sync for reminders (client-side OAuth, no backend) — in
# Google Cloud Console: enable the Google Calendar API, then Credentials →
# Create OAuth client ID → Web application. Add your app's origin(s) under
# "Authorized JavaScript origins" (e.g. http://localhost:5173 for dev, your
# Netlify domain for production — no redirect URI needed, this uses the
# token flow). While the OAuth consent screen is unverified/"Testing", add
# your Google account(s) as test users. Leave this unset and reminders stay
# fully local — Google sync is entirely optional.
VITE_GOOGLE_CLIENT_ID=
