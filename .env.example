# Firebase (Firestore) — copy to .env.local and fill in from your Firebase
# project settings (Project settings → General → Your apps → Web app).
# Leave these unset and the app runs fully on localStorage instead.
# Photos are compressed in the browser (≤5 MB in → WebP, ~450 KB out) and
# uploaded to Cloud Storage under spl_media/ — that needs STORAGE_BUCKET set
# and Storage enabled in the console (deploy storage.rules from this repo).
# Without a bucket, photos are stored inline as small data URLs instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google photos for places in "Places We Visited" (optional). In Google
# Cloud Console enable "Maps JavaScript API" and "Places API (New)", create
# an API key and restrict it to your site's HTTP referrers (localhost + your
# Netlify domain) and those two APIs. Unset → trips still work, just without
# the Google photo carousels.
VITE_GOOGLE_MAPS_API_KEY=

# local emulators (optional), e.g. 127.0.0.1:8080 / 127.0.0.1:9199
VITE_FIRESTORE_EMULATOR_HOST=
VITE_STORAGE_EMULATOR_HOST=

# Google Calendar sync for reminders (client-side OAuth, no backend) — in
# Google Cloud Console: enable the Google Calendar API, then Credentials →
# Create OAuth client ID → Web application. Add your app's origin(s) under
# "Authorized JavaScript origins" (e.g. http://localhost:5173 for dev, your
# Netlify domain for production — no redirect URI needed, this uses the
# token flow). While the OAuth consent screen is unverified/"Testing", add
# your Google account(s) as test users. Leave this unset and reminders stay
# fully local — Google sync is entirely optional.
VITE_GOOGLE_CLIENT_ID=
